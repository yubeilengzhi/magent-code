{
  "name": "magent",
  "version": "0.1.0",
  "description": "Cross-tool AI coding assistant with smart routing (built-in memory + skills)",
  "type": "module",
  "bin": {
    "magent": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-skills.js && node scripts/copy-public.js && node scripts/generate-skills.js",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest",
    "lint": "eslint .",
    "start": "node dist/cli/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "openai": "^4.0.0",
    "sql.js": "^1.10.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
